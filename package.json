{
  "name": "financehub-frontend",
  "version": "1.0.26",
  "description": "FinanceHub desktop application",
  "main": "./out/main/index.js",
  "author": "FinanceHub",
  "homepage": "https://github.com/MatySeitour/financehub-frontend",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint src electron.vite.config.ts --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "npm run lint -- --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "release": "npm run build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.financehub.app",
    "productName": "FinanceHub",
    "asar": true,
    "forceCodeSigning": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "out/renderer",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "MatySeitour",
        "repo": "financehub-frontend",
        "releaseType": "release"
      }
    ],
    "win": {
      "executableName": "FinanceHub",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "shortcutName": "FinanceHub",
      "uninstallDisplayName": "FinanceHub",
      "createDesktopShortcut": "always"
    },
    "mac": {
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "category": "Office",
      "maintainer": "FinanceHub",
      "target": [
        "AppImage"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@emotion/react": "^11.13.5",
    "@heroui/react": "^2.8.2",
    "@heroui/select": "2.4.10",
    "@heroui/system": "^2.4.20",
    "@heroui/theme": "2.4.6",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.8.2",
    "@table-library/react-table-library": "^4.1.7",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.11",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.532.0",
    "motion": "^12.0.6",
    "react-apexcharts": "^1.6.0",
    "react-cookie": "^7.2.2",
    "react-hook-form": "^7.91.0",
    "react-query": "^3.39.3",
    "react-router": "^7.18.4",
    "sonner": "^2.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^20.17.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.31",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.5.2",
    "vite": "^6.4.4"
  }
}
